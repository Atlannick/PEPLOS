## 4. Dosya & Klasör Yapısı

```
PEPLOS/
├── PEPLOSApp.swift              # @main giriş noktası
├── ContentView.swift            # Kök view; tüm store'lar burada oluşturulur
├── HomeView.swift               # Ana ekran (Lucky Look, özet, son eklenenler)
├── ClosetView.swift             # Gardırop listesi
├── OutfitsView.swift            # Kayıtlı kombinler
├── StylistView.swift            # Hava durumu tabanlı öneri
├── SettingsView.swift           # Ayarlar
├── BuildOutfitView.swift        # Kombin oluşturma akışı
├── AddItemView.swift            # Fotoğraf ekleme akışı
├── AddItemMetadataView.swift    # Kıyafet metadata girişi
├── TimeOfDayGreeting.swift      # Home'daki selamlama bileşeni
│
├── Components/                  # Yeniden kullanılabilir SwiftUI bileşenleri
│   ├── MainTab.swift            # Tab enum tanımı
│   ├── MainTabBar.swift         # Özel tab bar
│   ├── OutfitCard.swift
│   ├── ClothingCard.swift
│   ├── LuckyLookResultView.swift
│   ├── HomeSummaryCard.swift
│   └── ...                      # ~28 dosya
│
├── Models/                      # Saf veri modelleri (Codable struct'lar)
│   ├── ClothingItem.swift       # Kıyafet satırı (persistence birimi)
│   ├── ClosetItem.swift         # UI'ye özel display modeli
│   ├── ClothingCategory.swift   # Kategori entity
│   ├── SavedOutfit.swift        # Kaydedilmiş kombin
│   ├── CollectionModel.swift    # Koleksiyon entity
│   └── ClothingImportProcessingPath.swift
│
├── Services/                    # Store'lar, servisler, yöneticiler
│   ├── ClosetStore.swift        # Gardırop durumu + persistence
│   ├── OutfitStore.swift        # Kombin durumu + persistence
│   ├── CollectionService.swift  # Koleksiyon yönetimi
│   ├── AppSettingsStore.swift   # Uygulama tercihleri
│   ├── LuckyLookManager.swift   # AI outfit öneri motoru
│   ├── StylistWeatherController.swift
│   ├── ImageProcessor.swift     # Görüntü kırpma, boyutlandırma, aspect ratio
│   ├── BackgroundRemovalService.swift
│   ├── BackupService.swift      # JSON yedekleme/geri yükleme
│   ├── DurableStore.swift       # Çift yazma persistence (JSON + UserDefaults)
│   └── ...                      # ~22 dosya
│
├── Fashion/                     # On-device moda zekası
│   ├── FashionEngine.swift      # Dışa açık facade (enum)
│   ├── FashionRules.swift       # Renk & kategori uyum kuralları
│   ├── FashionTypes.swift       # Enum'lar ve protokoller
│   ├── FashionKnowledge.swift   # Bilgi tabanı
│   └── ...                      # ~7 dosya
│
├── Settings/                    # Ayarlar alt ekranları
├── Onboarding/                  # İlk açılış rehberi
└── Theme/
    └── AppTheme.swift           # Merkezi renk & gölge paleti
```

